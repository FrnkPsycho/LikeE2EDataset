# team.env —— 被测方维护（一个文件）：模型 + agent + 队伍身份。
# 用法：复制本文件为 team.env 并填真实值。MODEL_API_KEY 是机密，建议不进版本库、
# 由平台运行时注入；host_run / docker_env 读的是 team.env（不是本 example）。
#
# ── 模型访问（OpenAI 兼容，host_run 会翻译成各 agent 的 wire 格式）──
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_API_KEY=sk-your-key-here
MODEL_NAME=deepseek-chat

# ── codex 行为开关（可选；留空即用评测默认值，一般不填）──
#   MODEL_REASONING_EFFORT：推理强度。默认 high —— codex 对不认识的模型名会回落
#     到 none，等于把思维链整个关掉，默认值就是为了避免这个。
#   MODEL_WEB_SEARCH：默认 disabled —— codex 的联网搜索工具由模型服务端执行，
#     不经过本容器的 egress 代理，题目侧的网络隔离拦不住。
# MODEL_REASONING_EFFORT=
# MODEL_WEB_SEARCH=

# ── agent 选择 ──
#   codex    = 预置 Codex CLI（走 Responses 协议）
#   qwencode = 预置 Qwen Code（走 chat 协议）
#   custom   = 自研 harness（见下 CUSTOM_ENTRYPOINT）
#
# 注意：端点必须支持所选 agent 的协议。只提供 Responses API 的模型端点只能配
# codex —— 实测 open.bigmodel.cn 的 glm-5.3 就是这种：/chat/completions 返回
# 403 model_access_denied，配 qwencode 会一次都调不通。
AGENT=codex
# 仅 AGENT=custom 时填写：自研 harness 的 entrypoint.sh 路径（宿主路径，挂到 /challenge/agent/entrypoint.sh）
CUSTOM_ENTRYPOINT=

# ── 队伍身份（结果归属 + 未来 submission 路由）──
TEAM_ID=team1
