# team.env —— 被测方维护（一个文件）：模型 + agent + 队伍身份。
# 用法：复制本文件为 team.env 并填真实值。MODEL_API_KEY 是机密，建议不进版本库、
# 由平台运行时注入；host_run / docker_env 读的是 team.env（不是本 example）。
#
# ── 模型访问（OpenAI 兼容，host_run 会翻译成各 agent 的 wire 格式）──
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_API_KEY=sk-your-key-here
MODEL_NAME=deepseek-chat

# ── agent 选择 ──
#   codex    = 预置 Codex CLI（要求 Responses 协议）
#   qwencode = 预置 Qwen Code（chat 协议）
#   custom   = 自研 harness（见下 CUSTOM_ENTRYPOINT）
AGENT=codex
# 仅 AGENT=custom 时填写：自研 harness 的 entrypoint.sh 路径（宿主路径，挂到 /challenge/agent/entrypoint.sh）
CUSTOM_ENTRYPOINT=

# ── 队伍身份（结果归属 + 未来 submission 路由）──
TEAM_ID=team1
