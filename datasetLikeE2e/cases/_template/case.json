{
  "case_id": "<CASE_ID>",
  "judgment": {
    "type": "flag",
    "flag_path": "/tmp/flag",
    "nonce_write": "printf '%s' {nonce} > /tmp/flag; chmod 0644 /tmp/flag"
  },
  "target": {
    "image": "<项目名>/<target>:1",
    "patched_image": "<项目名>/<target>:patched",
    "container": null,
    "compose_service": "target",
    "target_image_env": "TARGET_IMAGE",
    "healthy_check": "container"
  },
  "gateway": {
    "mgmt_url": "http://127.0.0.1:<端口>",
    "admin_token": "local-admin-token"
  },
  "replay": {
    "driver": "command",
    "attack_cmd": [
      "-v",
      "{poc}:/poc/poc.bin",
      "traffic",
      "python",
      "traffic/replay_poc.py",
      "--poc",
      "/poc/poc.bin",
      "--gateway",
      "http://egress:80"
    ],
    "reference_attack_cmd": [
      "traffic",
      "python",
      "traffic/reference_poc.py",
      "--gateway",
      "http://egress:80"
    ],
    "evidence_key": "body_text",
    "variant_cmd": [
      "traffic",
      "python",
      "traffic/mutated_pocs.py",
      "--run-all",
      "--gateway",
      "http://egress:80"
    ]
  },
  "patch": {
    "build_cmd": "bash whitebox/service/build.sh patched {patch}"
  },
  "business": {
    "driver": "command",
    "command": [
      "traffic",
      "sh",
      "-c",
      "cd /work && python -m pytest business_tests/test_business.py -q"
    ]
  },
  "defense": {
    "driver": "gateway",
    "dir": "blackbox/defense",
    "module": "blue_controller"
  },
  "ndr": {
    "url": "http://127.0.0.1:<NDR端口>",
    "admin_token": "local-ndr-admin",
    "blue_token": "local-ndr-blue",
    "rule_token": "local-ndr-rule"
  }
}
