# case.env —— 赛题拓扑 + agent 网络策略（模板）
# 网络名 = compose 项目名 <项目> + 网络名（blackbox/docker-compose.yml）
# 六张网的名字是固定的：entry_net / gateway_net / target_net / mgmt_net / agent_net / egress_out

CASE_ID=<CASE_ID>

COMPOSE_PROJECT=<项目名>                    # 与 blackbox/docker-compose.yml 的 name 一致
GATEWAY_MGMT_URL=http://127.0.0.1:<端口>    # 宿主机回环访问网关管理面

AGENT_NETWORK=<项目>_agent_net               # agent 固定 join 的隔离网（squid 侧）
EGRESS_PROXY=http://egress_proxy:3128        # agent 唯一模型出网口
BLACKBOX_ATTACKER_NETWORK=<项目>_entry_net   # 攻击方 join 的入口网（只能经共享出口打网关）
BLACKBOX_DEFENDER_NETWORK=<项目>_mgmt_net    # 黑盒防御者 join 的管理网（触达网关管理面）
BLUE_API=http://gateway:8080                 # 蓝队接口（网关管理面）
NO_PROXY=egress,gateway,<网段>                # 入口与蓝队接口直连，不走 egress 代理
